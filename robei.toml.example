# Copy to C:\dev\robei-mcp\robei.toml (or point ROBEI_MCP_CONFIG at a copy).
# Precedence: environment variable > this file > built-in default.
# runtime_status().config.sources reports which one won for every key.

[paths]
# Everything the server writes must live under workspace.
workspace = "C:/dev/robei-mcp/workspace"
robei_home = "E:/Robei"
robei_exe = "E:/Robei/bin/Robei.exe"
# The IDE the robei_gui_* tools drive. A copy outside E:\Robei keeps the
# install tree read-only.
gui_exe = "D:/robei-lab/robei/bin/Robei.exe"
iverilog = "E:/Robei/bin/iverilog.exe"
vvp = "E:/Robei/bin/vvp.exe"
yosys = "E:/Robei/bin/yosys.exe"
verilator = "C:/msys64/ucrt64/bin/verilator_bin.exe"
verilator_root = "C:/msys64/ucrt64/share/verilator"
# Read-only roots that read_robei_model / read_robei_project may look into.
model_roots = ["C:/ProgramData/Robei"]

[limits]
default_timeout_s = 30
max_timeout_s = 120
